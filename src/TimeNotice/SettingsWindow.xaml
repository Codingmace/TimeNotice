<Window x:Class="TimeNotice.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TimeNotice Settings" Width="420" Height="660"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#FAFAFC">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#E5E5EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#111116"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#6B6B74"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#3A3A42"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6"/>
            <Setter Property="BorderBrush" Value="#D5D5DC"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="16,16,16,8" Orientation="Vertical">
        <TextBlock Text="TimeNotice Settings" FontSize="18" FontWeight="Bold" Foreground="#111116"/>
        <TextBlock Text="Changes apply instantly on Save." FontSize="12" Foreground="#6B6B74" Margin="0,0,0,8"/>

        <TabControl Height="470">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="General time reminders" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="Wall-clock popups on your schedule." Style="{StaticResource Hint}"/>
                        <CheckBox x:Name="GeneralEnabledBox" Content="Enabled" IsChecked="True"/>
                        <TextBlock Text="Every X minutes" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="IntervalBox" Text="30"/>
                        <CheckBox x:Name="WindowOnlyBox" Content="Only between times"/>
                        <StackPanel x:Name="GeneralTimePanel" Orientation="Horizontal">
                            <StackPanel>
                                <TextBlock Text="From (HH:mm)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="WindowStartBox" Width="110" Margin="0,4,8,4" Text="09:00"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="To (HH:mm)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="WindowEndBox" Width="110" Margin="0,4,0,4" Text="23:00"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Game">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Game session reminders" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="Uses its own interval while a listed game is focused." Style="{StaticResource Hint}"/>
                        <CheckBox x:Name="GameEnabledBox" Content="Enabled"/>
                        <TextBlock Text="Every Y minutes while game is active" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="GameIntervalBox" Text="60"/>
                        <CheckBox x:Name="CountBox" Content="Count while merely running (no focus needed)"/>
                        <TextBlock Text="Games (one exe per line — spotify.exe = Spotify)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="GameBox" Height="70"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Text="Ignored — never counts as gameplay or sessions (one exe per line)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="IgnoreBox" Height="52"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                        <CheckBox x:Name="GameWindowOnlyBox" Content="Only between times"/>
                        <StackPanel x:Name="GameTimePanel" Orientation="Horizontal">
                            <StackPanel>
                                <TextBlock Text="From (HH:mm)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="GameWindowStartBox" Width="110" Margin="0,4,8,4" Text="09:00"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="To (HH:mm)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="GameWindowEndBox" Width="110" Margin="0,4,0,4" Text="23:00"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Game main line (blank = use main). {game} {elapsed} work here." Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="GameMainBox" Text=""/>
                        <TextBlock Text="Game sub line (blank = use sub)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="GameSubBox" Text=""/>
                        <CheckBox x:Name="GameNotifyBox" Content="Pop when a game is detected"/>
                        <TextBlock Text="Detection line ({game} {interval})" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="GameDetectTemplateBox" Text="{}{game} detected"/>
                        <TextBlock Text="Detection sub line (blank = none)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="GameDetectSubBox" Text="Monitoring every {interval} min"/>
                    </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Heuristics (unknown games)" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="Finds unlisted games by fullscreen/GPU + idle. 30s dips never flap." Style="{StaticResource Hint}"/>
                        <CheckBox x:Name="HeurEnabledBox" Content="Enabled" IsChecked="True"/>
                        <TextBlock Text="Sustained seconds before a session starts" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="HeurStartBox" Text="60"/>
                        <TextBlock Text="Seconds of focus loss/idle before suspect" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="HeurSuspectBox" Text="30"/>
                        <TextBlock Text="Suspect minutes before session closes" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="HeurInactiveBox" Text="5"/>
                        <TextBlock Text="GPU % that counts as active" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="HeurGpuBox" Text="5"/>
                    </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Popup">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Wording" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="Use {time} and {next} — they fill in automatically." Style="{StaticResource Hint}"/>
                        <TextBlock Text="Main line" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="MainTemplateBox" Text="It is now {time}"/>
                        <TextBlock Text="Sub line" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="SubTemplateBox" Text="Next: {next}"/>
                        <CheckBox x:Name="ShowNextBox" Content="Show sub line" IsChecked="True"/>
                        <TextBlock Text="Box stays (seconds)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="DisplayBox" Text="5"/>
                    </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Look &amp; position" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="Corner, theme, colors. Custom shows extra fields." Style="{StaticResource Hint}"/>
                        <TextBlock Text="Popup corner" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="PositionBox" Margin="0,4,0,4">
                            <ComboBoxItem Content="Top left" Tag="TopLeft"/>
                            <ComboBoxItem Content="Top right" Tag="TopRight"/>
                            <ComboBoxItem Content="Bottom left" Tag="BottomLeft"/>
                            <ComboBoxItem Content="Bottom right" Tag="BottomRight"/>
                        </ComboBox>
                        <TextBlock Text="Theme" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="ThemeBox" Margin="0,4,0,4">
                            <ComboBoxItem Content="Dark" Tag="Dark"/>
                            <ComboBoxItem Content="Light" Tag="Light"/>
                            <ComboBoxItem Content="Match Windows" Tag="MatchHost"/>
                            <ComboBoxItem Content="Custom colors…" Tag="Custom"/>
                        </ComboBox>
                        <StackPanel x:Name="CustomColorPanel">
                            <TextBlock Text="Background (#AARRGGBB or #RRGGBB)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="BgBox" Text="#CC1E1E1E"/>
                            <TextBlock Text="Main text color" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TextColorBox" Text="#FFFFFFFF"/>
                            <TextBlock Text="Sub text color" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="SubColorBox" Text="#FFBBBBBB"/>
                        </StackPanel>
                        <TextBlock Text="Popup opacity" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Slider x:Name="OpacitySlider" Minimum="20" Maximum="100" Width="220" Margin="0,4,8,4" TickFrequency="5" IsSnapToTickEnabled="True"/>
                            <TextBlock x:Name="OpacityLabel" Text="92%" VerticalAlignment="Center" FontSize="12" Foreground="#3A3A42"/>
                        </StackPanel>
                    </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Quiet">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Quiet apps" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="Never pop while one of these is focused." Style="{StaticResource Hint}"/>
                        <TextBox x:Name="QuietBox" Height="120"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="WarnText" Foreground="#B45309" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,4"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveButton" Content="Save" Width="90" Padding="10,5" Margin="0,0,8,0"
                    Background="#2563EB" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Click="Save_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="90" Padding="10,5" Click="Cancel_Click"/>
        </StackPanel>
        <TextBlock x:Name="ErrorText" Foreground="#B91C1C" Margin="0,4,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</Window>
